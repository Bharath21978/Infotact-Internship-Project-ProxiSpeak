# ============================================================
# ProxiSpeak backend configuration template.
#
#   1. Copy this file to .env        (cp .env.example .env)
#   2. Fill in the values marked REQUIRED
#   3. NEVER commit .env  (it is already in .gitignore)
# ============================================================

NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to call the API and
# open Socket.IO connections with cookies. No trailing slash, no "*".
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: comma-separated room ids players may join. Copy the EXACT ids
# used by the React frontend. Leave empty to accept any well-formed id.
ALLOWED_ROOM_IDS=

# true  = Socket.IO rejects clients without a valid login cookie.
# false = anonymous sockets allowed (old behaviour; local debugging only).
AUTH_ENABLED=true

# ---------------- MySQL ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=proxispeak_app
# REQUIRED: the password of the MySQL user above
DB_PASSWORD=
DB_NAME=proxispeak
DB_CONNECTION_LIMIT=10

# ---------------- JWT / cookie ----------------
# REQUIRED: long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token + cookie lifetime: 900, 30m, 1h, 7d  (min 1m, max 7d)
JWT_EXPIRES_IN=1h
COOKIE_NAME=proxispeak_token
# Leave false for http://localhost. MUST be true in production (HTTPS).
COOKIE_SECURE=false
# lax | strict | none   (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Optional. Leave empty for a host-only cookie.
COOKIE_DOMAIN=

# ---------------- Hardening ----------------
# bcrypt cost factor (4-15). 12 is a good default.
BCRYPT_ROUNDS=12
# Failed login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_ENABLED=true
# Number of reverse-proxy hops in front of this server (0 = none).
TRUST_PROXY=0
